# ---------- Frontend (Vite) ----------
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Server (Vercel env) ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# كاشير — نفس مفاتيح حساب فرصة
KASHIER_MERCHANT_ID=MID-xxxx-xxx
KASHIER_API_KEY=            # Payment API Key من لوحة كاشير
KASHIER_MODE=test           # test | live
KASHIER_ALLOWED_METHODS=card,wallet

# Bitnob — بعد الموافقة على حسابك
BITNOB_BASE_URL=https://api.bitnob.co
# للتجربة: https://sandboxapi.bitnob.co
BITNOB_SECRET_KEY=sk_...

# مفتاح تشفير بيانات الكروت (32 بايت hex = 64 حرف)
# توليده:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_ENC_KEY=

# رابط التطبيق النهائي (من غير / في الآخر)
APP_BASE_URL=https://vcc.alnamaa.eg

# ويبهوك n8n لإرسال OTP وإشعارات واتساب (اختياري بس مهم)
N8N_NOTIFY_WEBHOOK=

# حماية الكرون
CRON_SECRET=change-me
